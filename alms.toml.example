# ALMS Configuration
# Copy to alms.toml and customize. All values shown are defaults.
# Secrets (API keys, tokens) are stored in .alms/secrets.json via `alms auth set`
# or the web UI. They are never stored in this file or read from env vars.
# Set ALMS_MASTER_KEY env var to encrypt secrets at rest (AES-256-GCM).

[server]
bind = "127.0.0.1:8080"
# Data directory for SQLite DB, secrets, workspace files.
# Follows the CWD-as-workspace model (like .git/ or .cargo/).
# Override with ALMS_DATA_DIR env var.
# data_dir = "./.alms"

[llm]
# LLM provider: "openrouter" (default), "openai", or "anthropic"
provider = "openrouter"
# provider base URL
base_url = "https://openrouter.ai/api/v1"
# model identifier
model = "moonshotai/kimi-k2.6"
# request timeout
timeout_secs = 120
# retry count on transient failures
max_retries = 2
# token budget per run (0 = unlimited)
max_tokens_per_run = 0
# set to true for testing without an API key
mock = false
# per-chunk SSE read timeout (seconds). If no data arrives within this
# window, the stream is treated as stalled and terminated. Increase for
# slow reasoning models or high-latency connections.
stream_chunk_timeout_secs = 60

# Set API key via `alms auth set`:
#   alms auth set openrouter sk-...
#   alms auth set openai sk-...
#   alms auth set anthropic sk-ant-...
# Switch provider: export ALMS_LLM_PROVIDER=anthropic
# Mock mode (no key needed): export ALMS_LLM_MOCK=1
#
# NOTE: API key env vars (OPENROUTER_API_KEY, etc.) are NO LONGER used.
# They are ignored for security — agents can read env vars via shell_exec.

[session]
idle_timeout_secs = 86400            # 24 hours
auto_archive = true
archive_ttl_secs = 2592000          # 30 days
max_messages = 10000
# SESSION STORAGE limit: max tokens of conversation history to retain on disk.
# This should be >= context.max_input_tokens (the LLM per-request budget)
# because the session must store at least as much as the LLM can consume.
# Typically set 2x the LLM context window to keep some older history around.
max_context_tokens = 256_000

[context]
# DEPRECATED as of v0.2.4 (#869): `recent_window` and `summary_interval`
# are no longer recognised — the compact strategy is now token-threshold-
# driven (see compact_trigger_pct / compact_retain_pct below). Configs
# that still set them produce a one-time WARN at boot and are ignored.
#
# Context window strategy:
#   "truncate"  - drop oldest messages to fit the token budget (simple, lossy)
#   "compact"   - summarise older messages once history crosses the trigger
#                 threshold, keep the recent verbatim tail
#   "full"      - send everything (for small conversations or cheap models)
#
# (Legacy alias "sliding-summary" is accepted at config-load time and
# rewritten to "compact"; remove it from your config when convenient.)
strategy = "truncate"
# PER-REQUEST LLM budget: max tokens to send to the LLM in a single request.
# Should match your model's context window size. This is different from
# session.max_context_tokens, which is the total session storage limit.
max_input_tokens = 128000
# When strategy = "compact": fold older messages into a summary once
# the assembled history exceeds this fraction of the EFFECTIVE history
# budget (max_input_tokens minus the system / input / episodic /
# reserve overhead — i.e. the actual room available for history).
# Range: 0.50–0.95. Default: 0.80.
compact_trigger_pct = 0.80
# When compaction fires, retain this fraction of the EFFECTIVE history
# budget worth of recent verbatim messages; older messages collapse
# into the summary block. Range: 0.20–0.60. Default: 0.40.
# (Enforced floor: compact_retain_pct + 0.10 <= compact_trigger_pct, so
# compaction always measurably reduces context size.)
compact_retain_pct = 0.40
# Episodic memory: how run summaries are generated after each run.
#   "off"       - disabled (default). No summaries, no episodic context injection.
#   "heuristic" - one-line summary from truncated input + output. Zero LLM cost.
#   "llm"       - rich summary via agent's model (or summary_model if configured).
# Override with: ALMS_RUN_SUMMARY_MODE=heuristic
run_summary_mode = "off"
# Optional cheaper model for the summary task (issue #866). Falls back to the
# agent's default model when commented out.
# summary_model = "minimax/minimax-m2.7"
# Optional dedicated provider for the summary task. When set, the summary
# client is re-targeted at this provider via `with_provider_and_secrets` so
# `summary_model` can be a slug for a different provider than the agent
# (e.g. agent on Anthropic, summary on OpenRouter). Must reference a
# configured `[llm.providers.<name>]` block whose API key is resolvable.
# Leave commented out to inherit the agent's resolved provider.
#
# IMPORTANT (#871): set `summary_model` and `summary_provider` together.
# The agent's resolved model belongs to the AGENT's provider namespace
# and is NOT a safe fallback for the summary provider's wire — `PATCH
# /settings` rejects this combination, and the runtime applies a leak
# guard for hand-edited TOML configs that clears the model so the wire
# fails fast rather than 404'ing on the summary provider with the
# agent provider's model name.
# summary_provider = "openrouter"
# Max tokens for episodic run summaries injected into context window.
# Hard-capped at 15% of max_input_tokens — values above the cap are clamped.
# Override with: ALMS_RUN_SUMMARY_BUDGET=4000
run_summary_budget = 2000

[tools]
# which builtin tools to enable
enabled = ["echo", "math", "http_get"]
# timeout for tool execution
timeout_secs = 30
# max output size from a tool (bytes)
max_output_bytes = 65536
# Filesystem sandbox root — fs_read/fs_write/fs_list paths must resolve within
# this directory. Default: "." (safe — restricts to current working directory).
# Set to "" for unrestricted filesystem access.
# Override with: ALMS_SANDBOX_ROOT=/custom/path
sandbox_root = "."
# Shell execution policy: "sandboxed" (default) or "unrestricted".
# "sandboxed" — shell cwd is restricted to sandbox_root. On Linux 5.13+,
#   Landlock filesystem restrictions are also applied so the child process
#   can only access files within sandbox_root (plus read-only system paths).
#   On Windows/macOS, sandboxed mode restricts cwd only — the command itself
#   can still access files outside the sandbox at the OS level.
# "unrestricted" — no cwd or filesystem restriction (power-user / full access).
# Override with: ALMS_SHELL_POLICY=unrestricted
shell_policy = "sandboxed"

[security]
# Operator-only escape hatch from the project-root filesystem sandbox (#947).
#
# Agents listed here run WITHOUT the project-root sandbox introduced in
# the workspace v2 redesign (#945) — `fs_*` tools have no path prefix to
# enforce, and the `shell` tool's persistent cwd is not pinned to the
# project root. Listed agents are subject only to OS-level user
# permissions of the daemon process: `fs_read /etc/passwd` works, `shell
# ls /` returns the real root.
#
# The two independent operator policies still apply to listed agents:
#   - `[tools.shell_permissions]` allow / deny / classifier_overrides (#717)
#   - `[tools.shell_classification_mode]` destructive-command floor (#745)
# They are defense-in-depth controls, not part of the sandbox boundary.
#
# THIS KNOB IS CONFIG-FILE-ONLY. `PATCH /settings` rejects any payload
# referencing it with `400 SECURITY_KNOB_NOT_PATCHABLE`. PATCH mutability
# would let a compromised auth token silently widen the blast radius of
# an existing agent. Edit this file and restart the gateway to change
# the list.
#
# A boot-time WARN fires for every listed agent and a per-run WARN fires
# at every `run_started` for a listed agent so log scanners can correlate
# runs against the loosened sandbox.
#
# Default: empty list. Uncomment and add agent names (matching `alms
# agent create --name <name>`) to opt them out of the sandbox.
# allow_full_os_access = ["operator-shell", "deploy-bot"]
allow_full_os_access = []

# ─────────────────────────────────────────────────────────────────────
# Per-agent git worktree mode (#946) — workspace v2
# ─────────────────────────────────────────────────────────────────────
#
# Worktree mode is a PER-AGENT setting, not a server-wide one. It is
# configured at agent-create time, NOT in this file:
#
#   alms agent create my-agent --worktree-mode git
#   alms agent config my-agent --worktree-mode off
#
# When `worktree_mode = "git"` the gateway runs `git worktree add
# <project>/.alms/worktrees/<name>/ -b alms/<name>` and pins the
# agent's filesystem sandbox at that worktree path instead of the
# project root. Multiple agents on the same git project can work in
# parallel without filesystem collisions.
#
# Precedence with `[security].allow_full_os_access` above: an agent
# listed in `allow_full_os_access` runs WITHOUT any filesystem
# sandbox at all, regardless of its worktree mode. The worktree
# itself is still created at agent-create time so the operator can
# flip the security knob off later without re-running `git worktree
# add` — only the run-time sandbox attachment is bypassed. A
# boot-time WARN fires for every agent in this overlap so the
# precedence is visible in the daemon log.
#
# Non-git projects + `--worktree-mode git` returns `400
# WORKTREE_REQUIRES_GIT` at create / PATCH time. There is no
# silent fallback to project-root mode.

[logging]
# Enable/disable file-based logging. Only applies to the gateway command.
# Set to false to disable file logging entirely (e.g., in containers with journal capture).
# Override with: ALMS_LOG_FILE_ENABLED=false
file_enabled = true

# Directory for persistent log files. Default: "{data_dir}/logs/" (i.e. ./.alms/logs/).
# Override with: ALMS_LOG_DIR=/custom/log/path
# log_dir = "./.alms/logs"

# Log level for file output. Stderr level is controlled by RUST_LOG (default: info).
# File output defaults to "debug" for more detail in post-hoc investigation.
# Valid: trace, debug, info, warn, error
# Override with: ALMS_LOG_FILE_LEVEL=info
file_level = "debug"

# Log rotation policy: "daily" (default), "hourly", or "never".
# Override with: ALMS_LOG_ROTATION=hourly
rotation = "daily"

# Telegram channel (optional)
# Set token via: alms auth set telegram 123456:ABC-DEF
# [channels.telegram]
# poll_interval_secs = 5
#
# Per-agent Telegram tokens: instead of a global bot token, you can assign
# a dedicated Telegram bot to each agent via the API or CLI:
#   alms agent create --name my-agent --telegram-token "123456:ABC-DEF"
# These are stored in the agent registry (SQLite), not in this config file.
#
# NOTE: TELEGRAM_BOT_TOKEN env var is NO LONGER used.
# Use `alms auth set telegram <token>` instead.
