# ALMS Configuration
# Copy to alms.toml and customize. All values shown are defaults.
# Secrets (API keys, tokens) are stored in data/secrets.json (via `alms auth set`
# or the UI) with env-var fallback. They are never stored in this file.
# Set ALMS_MASTER_KEY to encrypt secrets at rest (AES-256-GCM).

[server]
bind = "127.0.0.1:8080"
# Data directory for SQLite DB, secrets, workspace files.
# Override with ALMS_DATA_DIR env var.
# data_dir = "./data"

[llm]
# LLM provider: "openai" (OpenRouter-compatible, default) or "anthropic"
provider = "openai"
# provider base URL
base_url = "https://openrouter.ai/api/v1"
# model identifier
model = "openrouter/moonshotai/kimi-k2.5"
# request timeout
timeout_secs = 120
# retry count on transient failures
max_retries = 2
# token budget per run (0 = unlimited)
max_tokens_per_run = 0
# set to true for testing without an API key
mock = false
# per-chunk SSE read timeout (seconds). If no data arrives within this
# window, the stream is treated as stalled and terminated. Increase for
# slow reasoning models or high-latency connections.
stream_chunk_timeout_secs = 60

# Set API key via environment variable:
#   export OPENROUTER_API_KEY=sk-...
#   export OPENAI_API_KEY=sk-...        (alternative for OpenAI-compatible)
#   export ANTHROPIC_API_KEY=sk-ant-... (for Anthropic provider)
#   export ALMS_LLM_PROVIDER=anthropic  (switch provider)
#   export ALMS_LLM_MOCK=1             (mock mode, no key needed)

[session]
idle_timeout_secs = 86400            # 24 hours
auto_archive = true
archive_ttl_secs = 2592000          # 30 days
max_messages = 10000
# SESSION STORAGE limit: max tokens of conversation history to retain on disk.
# This should be >= context.max_input_tokens (the LLM per-request budget)
# because the session must store at least as much as the LLM can consume.
# Typically set 2x the LLM context window to keep some older history around.
max_context_tokens = 256_000

[context]
# Context window strategy:
#   "truncate"        - keep last N messages (simple, no LLM calls)
#   "sliding-summary" - rolling summary + recent window (best quality)
#   "full"            - send everything (for small conversations)
strategy = "truncate"
# PER-REQUEST LLM budget: max tokens to send to the LLM in a single request.
# Should match your model's context window size. This is different from
# session.max_context_tokens, which is the total session storage limit.
max_input_tokens = 128000
# number of recent messages to always keep in full
recent_window = 20
# how often to update rolling summary (in messages, for sliding-summary)
summary_interval = 30

[tools]
# which builtin tools to enable
enabled = ["echo", "math", "http_get"]
# timeout for tool execution
timeout_secs = 30
# max output size from a tool (bytes)
max_output_bytes = 65536
# Filesystem sandbox root — fs_read/fs_write/fs_list paths must resolve within
# this directory. Default: "." (safe — restricts to current working directory).
# Set to "" for unrestricted filesystem access.
# Override with: ALMS_SANDBOX_ROOT=/custom/path
sandbox_root = "."
# Shell execution policy: "sandboxed" (default) or "unrestricted".
# "sandboxed" — shell_exec cwd is restricted to sandbox_root.
# "unrestricted" — no cwd restriction (power-user / full root access).
# Note: sandboxed mode restricts cwd but cannot prevent the command itself
# from accessing files outside the sandbox. For true shell isolation, use
# a restricted OS user or Landlock (see docs/security-model.md §4.4).
# Override with: ALMS_SHELL_POLICY=unrestricted
shell_policy = "sandboxed"

[logging]
# Directory for persistent log files. Default: "{data_dir}/logs/" (i.e. ./data/logs/).
# Override with: ALMS_LOG_DIR=/custom/log/path
# log_dir = "./data/logs"

# Log level for file output. Stderr level is controlled by RUST_LOG (default: info).
# File output defaults to "debug" for more detail in post-hoc investigation.
# Valid: trace, debug, info, warn, error
# Override with: ALMS_LOG_FILE_LEVEL=info
file_level = "debug"

# Log rotation policy: "daily" (default), "hourly", or "never".
# Override with: ALMS_LOG_ROTATION=hourly
rotation = "daily"

# Telegram channel (optional)
# Set token via: export TELEGRAM_BOT_TOKEN=...
# [channels.telegram]
# poll_interval_secs = 5
#
# Per-agent Telegram tokens: instead of a global bot token, you can assign
# a dedicated Telegram bot to each agent via the API or CLI:
#   alms agent create --name my-agent --telegram-token "123456:ABC-DEF"
# These are stored in the agent registry (SQLite), not in this config file.
