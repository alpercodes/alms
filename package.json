{
  "name": "alms-frontend",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "22.23.1",
    "npm": "11.18.0"
  },
  "scripts": {
    "ui:build": "vite build",
    "ui:dev": "vite",
    "ui:typecheck": "tsc --noEmit && tsc -p tsconfig.boundary.json",
    "ui:lint": "eslint frontend vite.config.ts playwright.config.ts && eslint --no-ignore crates/alms-gateway/static/ui/api/client.js crates/alms-gateway/static/ui/hooks/use-agent-events.js crates/alms-gateway/static/ui/hooks/use-session-stream.js",
    "ui:format:check": "prettier --check frontend vite.config.ts playwright.config.ts eslint.config.js package.json tsconfig.json tsconfig.boundary.json",
    "ui:test": "npm run ui:test:unit && npm run ui:test:behavior",
    "ui:test:unit": "vitest run",
    "ui:test:behavior": "node crates/alms-gateway/tests/ui/_run-all.mjs",
    "ui:test:e2e": "playwright test",
    "ui:audit": "npm audit --audit-level=moderate",
    "ui:check": "npm run ui:typecheck && npm run ui:lint && npm run ui:format:check && npm run ui:test"
  },
  "dependencies": {
    "@preact/signals": "2.9.3",
    "dompurify": "3.4.14",
    "htm": "3.1.1",
    "marked": "18.0.6",
    "preact": "10.29.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
